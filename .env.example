# Supabase — hentes fra Settings → API i Supabase-dashboardet
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — KUN til server-side operasjoner (aldri i klient!)
# Hentes samme sted i Supabase-dashboardet
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
